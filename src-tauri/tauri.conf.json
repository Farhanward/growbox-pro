{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrowBox Pro",
  "version": "0.4.0",
  "identifier": "app.growbox.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "GrowBox Pro",
        "width": 1100,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "SocialNetworking",
    "shortDescription": "GrowBox Pro لتجهيز بوستات السوشيال ميديا الخليجية",
    "longDescription": "GrowBox Pro — تطبيق مرخص لتجهيز منشورات إنستغرام وتيك توك اعتمادًا على بيانات الحساب ووصف الوسائط مع ذكاء اصطناعي محلي.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/llama/*",
      "resources/node/*",
      "resources/data/*",
      "resources/playwright-fetcher.mjs",
      "resources/node_modules/playwright-core/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [],
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
