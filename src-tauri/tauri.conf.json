{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reach Optimizer",
  "version": "0.2.0",
  "identifier": "com.zeed.reachoptimizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Reach Optimizer",
        "width": 1100,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "SocialNetworking",
    "shortDescription": "خطة انتشار للمصورين والمبدعين الخليجيين",
    "longDescription": "تطبيق محلي يحلّل حسابات السوشيال ميديا العامة ويولّد خطة انتشار شهرية بدون تسجيل دخول.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/llama/*"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": []
    }
  }
}
